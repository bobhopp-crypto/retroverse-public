{
  "name": "retroverse-public",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node tools/next-dev.mjs",
    "dev:fast": "RETROVERSE_DEV_NO_CLEAN=1 node tools/next-dev.mjs",
    "dev:clean": "RETROVERSE_DEV_CLEAN=1 node tools/next-dev.mjs",
    "prebuild": "node tools/guard-no-concurrent-dev.mjs",
    "build": "next build && node tools/touch-production-build.mjs && node tools/ensure-search-index.mjs",
    "search:verify-index": "npx tsx tools/verify-search-index.ts",
    "start": "next start",
    "search:refresh-entities": "bash tools/run-search-entities-refresh.sh",
    "track:audit-album-links": "npx --yes tsx tools/run-album-link-recovery-audit.ts",
    "cover:audit": "npx --yes tsx tools/run-cover-integrity-audit.ts",
    "cover:verify": "npx --yes tsx tools/run-cover-repair-verify.ts",
    "cover:repair-batch": "npx --yes tsx tools/run-cover-repair-batch.ts",
    "cover:rv12-pilot": "npx --yes tsx tools/run-rv12-pilot.ts",
    "cover:retrain": "npx --yes tsx tools/run-cover-retrain.ts",
    "cover:next-batch": "npx --yes tsx tools/run-cover-next-batch.ts",
    "cover:train-queue-report": "npx --yes tsx tools/run-cover-train-queue-report.ts",
    "cover:backfill": "npx --yes tsx tools/run-cover-backfill.ts",
    "cover:backfill:once": "npx --yes tsx tools/run-cover-backfill.ts --once",
    "cover:backfill:test-one": "npx --yes tsx tools/test-cover-backfill-one.ts",
    "cover:backfill:skip-failed": "npx --yes tsx tools/run-cover-backfill-skip-failed.ts",
    "cover:backfill:safe": "npx --yes tsx tools/run-cover-backfill-safe.ts",
    "healing:review": "npx --yes tsx tools/run-healing-review.ts",
    "ops:chart-orbit": "npx --yes tsx tools/run-chart-orbit.ts",
    "ops:in-both-audit": "npx --yes tsx tools/run-in-both-reconciliation-audit.ts",
    "ops:year-workspace-counts": "npx --yes tsx tools/run-year-workspace-counts.ts",
    "smoke:public-search": "node tools/smoke-public-search.mjs"
  },
  "dependencies": {
    "next": "^15.3.3",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pg": "^8.15.2",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.8.3"
  }
}

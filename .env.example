# retroverse-welcome dev server (home search + optional cover proxy)
SEARCH_UPSTREAM_BASE_URL=http://localhost:3001

# Dev covers: next.config rewrites /retroverse/covers/* → welcome (default :3001)
# Or set R2/CDN origin (no trailing /retroverse/covers):
# NEXT_PUBLIC_RETROVERSE_COVER_BASE_URL=https://pub-….r2.dev

# RetroVerse Public production asset delivery (required for R2-backed covers/heroes)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=
# R2_PUBLIC_URL=
# RETROVERSE_COVER_BASE_URL=
# NEXT_PUBLIC_RETROVERSE_COVER_BASE_URL=

# Local graph inspector (/inspect) — read-only Postgres (music graph; may be localhost)
RETROVERSE_PG_HOST=localhost
RETROVERSE_PG_PORT=5432
RETROVERSE_PG_DATABASE=retroverse
RETROVERSE_PG_USER=bobhopp
# RETROVERSE_PG_PASSWORD=
# RETROVERSE_INSPECT=1
# RETROVERSE_CONTROL_CENTER=1

# Permanent pass registration system (Live /pass + Studio RV02-05).
# Must point at Neon production. No localhost default — misconfig fails loudly.
# RETROVERSE_PASS_PG_HOST=ep-….aws.neon.tech
# RETROVERSE_PASS_PG_PORT=5432
# RETROVERSE_PASS_PG_DATABASE=neondb
# RETROVERSE_PASS_PG_USER=neondb_owner
# RETROVERSE_PASS_PG_PASSWORD=
# RETROVERSE_PASS_PG_SSL=1
# RETROVERSE_PASS_ALLOW_LOCAL=1   # tests only

# Internal ops console (/ops) — PIN gate via cookie (local dev + production)
# RETROVERSE_OPS=1
# RETROVERSE_OPS_PIN=6324

# Creative Lab artwork generation (server-only)
# CREATIVE_LAB_ARTWORK_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# Arvey audience assistant (server-side only)
# ARVEY_MODEL=gpt-4o-mini

# Live Now Playing (Sunday Nights VDJ bridge)
# VDJ_NETWORK_PORT=8088
# VDJ_NETWORK_BEARER=
# LIVE_NOW_PLAYING_SECRET=
# LIVE_PORT=3000
# LIVE_BASE_URL=http://127.0.0.1:3000

# Retroverse Live broadcast push target (Broadcast Panel → deployed site).
# Uses LIVE_NOW_PLAYING_SECRET as the shared secret.
# RETROVERSE_LIVE_PUBLIC_URL=https://retroverse.live

# Sunday Nights production (Vercel): Postgres state + bundled snapshots (auto when VERCEL=1)
# SUNDAY_NIGHTS_STATE_PG=1
# SUNDAY_NIGHTS_USE_SNAPSHOTS=1
# RETROVERSE_PG_HOST=your-db-host
# RETROVERSE_PG_SSL=1

# Sunday Nights System → Deploy (Vercel deploy hook URL from project Settings → Git → Deploy Hooks)
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
# GITHUB_REPO=bobhopp-crypto/retroverse-public
# GITHUB_DEPLOY_BRANCH=main

# Canonical healing writes (local/staging only — human-approved album links)
# RETROVERSE_HEALING_APPLY=1

# RV12 cover promote/rollback (pilot: RVAL823723 only)
# RETROVERSE_COVER_APPLY=1

# Album/artist cover URLs (R2 CDN origin, no trailing /retroverse/covers)
# NEXT_PUBLIC_RETROVERSE_COVER_BASE_URL=https://pub-….r2.dev

# Local filesystem root for cover:audit (welcome public/ or repo with retroverse/covers)
# RETROVERSE_COVER_FS_ROOT=/path/to/retroverse-welcome/public

# retroverse-welcome dev server (home search + optional cover proxy)
SEARCH_UPSTREAM_BASE_URL=http://localhost:3001

# Dev covers: next.config rewrites /retroverse/covers/* → welcome (default :3001)
# Or set R2/CDN origin (no trailing /retroverse/covers):
# NEXT_PUBLIC_RETROVERSE_COVER_BASE_URL=https://pub-….r2.dev

# Local graph inspector (/inspect) — read-only Postgres
RETROVERSE_PG_HOST=localhost
RETROVERSE_PG_PORT=5432
RETROVERSE_PG_DATABASE=retroverse
RETROVERSE_PG_USER=bobhopp
# RETROVERSE_PG_PASSWORD=
# RETROVERSE_INSPECT=1
# RETROVERSE_CONTROL_CENTER=1

# Internal ops console (/ops) — PIN gate via cookie (local dev + production)
# RETROVERSE_OPS=1
# RETROVERSE_OPS_PIN=6324

# Sunday Nights production (Vercel): Postgres state + bundled snapshots (auto when VERCEL=1)
# SUNDAY_NIGHTS_STATE_PG=1
# SUNDAY_NIGHTS_USE_SNAPSHOTS=1
# RETROVERSE_PG_HOST=your-db-host
# RETROVERSE_PG_SSL=1

# Canonical healing writes (local/staging only — human-approved album links)
# RETROVERSE_HEALING_APPLY=1

# RV12 cover promote/rollback (pilot: RVAL823723 only)
# RETROVERSE_COVER_APPLY=1

# Album/artist cover URLs (R2 CDN origin, no trailing /retroverse/covers)
# NEXT_PUBLIC_RETROVERSE_COVER_BASE_URL=https://pub-….r2.dev

# Local filesystem root for cover:audit (welcome public/ or repo with retroverse/covers)
# RETROVERSE_COVER_FS_ROOT=/path/to/retroverse-welcome/public

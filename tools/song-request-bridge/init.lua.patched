local tap = hs.eventtap.new(
    { hs.eventtap.event.types.keyDown },
    function(event)

        local app = hs.application.frontmostApplication()

        if not app then
            return false
        end

        if app:name() ~= "Microsoft PowerPoint" then
            return false
        end

        local key = event:getCharacters(true)

        if key == "b" then
            hs.eventtap.leftClick(hs.mouse.absolutePosition())
            return true
        end

        return false
    end
)

tap:start()

-- Independent request bridge. pcall keeps the existing bingo remote active
-- even if the optional module or its configuration is unavailable.
local requestsOk, requestsModule = pcall(require, "retroverse_requests")
if requestsOk then
    retroverseRequests = requestsModule
    retroverseRequests.enable()
else
    hs.printf("Retroverse request bridge was not loaded: %s", tostring(requestsModule))
end
